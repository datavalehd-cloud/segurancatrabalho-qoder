# Copie para .env e preencha. NUNCA commite o .env real.
# Project URL do seu projeto Supabase (Settings -> API)
SUPABASE_URL=https://xxxxxxxx.supabase.co

# service_role key (Settings -> API -> Project API keys -> service_role).
# Usada SÓ pela Edge Function no servidor. Não vai para o navegador.
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-chave-service-role
